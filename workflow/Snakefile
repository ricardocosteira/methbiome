from snakemake.utils import validate
from scripts.validate_config_paths import validate_paths


validate(config, "../config/schema/config.schema.yaml")
validate_paths(config)

data_type = config["input_files"]["data"]["type"]
basecalled = config["input_files"]["data"]["basecalled"]

include: "rules/setup.smk"
if basecalled:
    include: "rules/validate_bam_input.smk"
elif data_type == "ONT":
    include: "rules/validate_pod5_input.smk"
    include: "rules/dorado.smk"
elif data_type == "PacBio":
    include: "rules/validate_bam_input.smk"
    include: "rules/jasmine.smk"
if config["input_files"]["dorado"]["archive"]["path"] is None:
    include: "rules/install_dorado.smk"
include: "rules/bam_to_fastq_gz.smk"
include: "rules/sequali.smk"
if config["input_files"]["kraken2"]["database"]["path"] is None:
    include: "rules/install_kraken2_db.smk"
include: "rules/kraken2.smk"
include: "rules/minimap2.smk"
include: "rules/modkit.smk"

outputs = [
    # With basecalled input, results.bam_dir is a directory from the user that we want to validate
    config["resources"]["input_validation"] if basecalled else config["results"]["bam_dir"],
    config["results"]["fastq_gz_dir"],
    config["results"]["kraken2"]["dir"],
    config["results"]["qc"]["sequali"]["dir"],
    config["results"]["minimap2"]["filtered_dir"],
    config["results"]["modkit"]["dir"]
]

if config["tabix"]:
    outputs.append(config["results"]["tabix"]["dir"])
    include: "rules/tabix.smk"

rule all:
    input:
        outputs
